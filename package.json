{
  "name": "remote-codex",
  "version": "0.1.10",
  "private": true,
  "description": "Linux desktop and Feishu remote-control shell for the native Codex CLI.",
  "desktopName": "Remote Codex",
  "license": "MIT",
  "author": "Remote Codex contributors",
  "homepage": "https://github.com/xiaofan4122/Remote-Codex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaofan4122/Remote-Codex.git"
  },
  "bugs": {
    "url": "https://github.com/xiaofan4122/Remote-Codex/issues"
  },
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "bash scripts/start-electron.sh",
    "api": "node src/api-server.js",
    "test": "node scripts/run-test-suite.js",
    "test:syntax": "node scripts/check-syntax.js",
    "check": "npm test && npm run test:syntax",
    "capture:replay": "node scripts/replay-terminal-capture.js",
    "capture:export-fixture": "node scripts/export-terminal-capture-fixture.js",
    "smoke:native-slash": "node scripts/smoke-native-slash.js",
    "smoke:feishu-rich-text": "node scripts/smoke-feishu-rich-text.js",
    "smoke:linux-artifact": "bash scripts/smoke-linux-release-artifact.sh",
    "test:native-slash-pages": "node scripts/test-native-slash-pages.js",
    "test:native-slash-commands": "node scripts/test-native-slash-commands.js",
    "test:permission-card-actions": "node scripts/test-permission-card-actions.js",
    "test:resume-hint": "node scripts/test-resume-hint.js",
    "test:remote-visual-notice": "node scripts/test-remote-visual-notice.js",
    "test:visual-session-state": "node scripts/test-visual-session-state.js",
    "test:remote-workflow-state": "node scripts/test-remote-workflow-state.js",
    "test:remote-output-cleanup": "node scripts/test-remote-output-cleanup.js",
    "test:remote-control-input": "node scripts/test-remote-control-input.js",
    "test:remote-file-delivery": "node scripts/test-remote-file-delivery.js",
    "test:latex-renderer": "node scripts/test-latex-renderer.js",
    "test:feishu-latex": "node scripts/test-feishu-latex.js",
    "test:feishu-reconnect": "node scripts/test-feishu-reconnect.js",
    "test:settings-ui": "node scripts/test-settings-ui.js",
    "test:local-turn-sync": "node scripts/test-local-turn-sync.js",
    "test:shell-syntax": "node scripts/test-shell-syntax.js",
    "test:skill-install": "node scripts/test-skill-install.js",
    "test:codex-session-manager": "node scripts/test-codex-session-manager.js",
    "test:codex-rollout-reader": "node scripts/test-codex-rollout-reader.js",
    "test:feishu-reply-stream": "node scripts/test-feishu-reply-stream.js",
    "test:feishu-remote-turn": "node scripts/test-feishu-remote-turn.js",
    "test:terminal-capture": "node scripts/test-terminal-capture.js",
    "test:terminal-key-input": "node scripts/test-terminal-key-input.js",
    "test:linux-installer": "node scripts/test-linux-installer.js",
    "test:development-toggle": "node scripts/test-development-version-toggle.js",
    "test:app-updates": "node scripts/test-app-updates.js",
    "test:single-instance": "node scripts/test-feishu-instance-coordinator.js",
    "test:multi-instance": "node scripts/test-feishu-instance-coordinator.js",
    "install:launchers": "bash scripts/install-launchers.sh",
    "rebuild": "electron-builder install-app-deps",
    "dist:linux": "electron-builder --linux tar.gz deb --publish never",
    "dist:linux:x64": "electron-builder --linux tar.gz deb --x64 --publish never",
    "dist:linux:arm64": "electron-builder --linux tar.gz deb --arm64 --publish never"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "mathjax": "^4.1.3",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
