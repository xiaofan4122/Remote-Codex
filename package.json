{
  "name": "remote-codex",
  "version": "0.1.0",
  "private": true,
  "description": "Remote-friendly Codex CLI monitor and controller.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "api": "node src/api-server.js",
    "corpus:cleaning": "node scripts/extract-cleaning-corpus.js",
    "corpus:replay": "node scripts/replay-cleaning-corpus.js",
    "install:launchers": "bash scripts/install-launchers.sh",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^30.5.1",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron-rebuild": "^3.2.9"
  }
}
